[mecha-canary]
name=Mecha canary (Fedora $releasever)
baseurl=https://pkg.mecha.so/repo/rpm/fedora-$releasever/canary/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://pkg.mecha.so/keys/mecha-signing-key.asc
# dnf5: a lower priority number wins, so this repo is preferred over Fedora's own (default 99) for custom-built kernel/firmware/etc. packages.
priority=1
